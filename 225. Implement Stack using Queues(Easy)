class MyStack {
    private int[] arr;
    private int top;
    public MyStack() {
            this.arr=new int[10];
            this.top=-1;
    }
    
    public void push(int x) {
        if(top==arr.length-1)
        {
            return;
        }
        arr[++top]=x;
        
    }
    
    public int pop() {
        if(top==-1)
        {
            return -1;
        }
        return arr[top--];
    }
    
    public int top() {
        return arr[top];
    }
    
    public boolean empty() {
        if(top==-1)
        {
            return true;
        }
        return false;
    }
}

