class Solution {
    public int searchInsert(int[] nums, int target) {
        for(int i=0;i<nums.length;i++)
        {
            if(target==nums[i])
            {
                return i;
            }
        }
        if(target<nums[0])
        {
            return 0;
        }
        if (nums.length == 1)
        {
            return 1; 
        }
        int small=nums[0];
        int large=nums[1];
        if(target>small && target<large)
        {
            return 1;
        }
        for(int i=1;i<nums.length-1;i++)
        {
            small=nums[i];
            large=nums[i+1];
            if(target>small && target<large)
            {
                return i + 1;
            }
        }
        return nums.length;
    }
}
