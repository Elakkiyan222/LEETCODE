class Solution {
    public int removeDuplicates(int[] nums) {
        int len=nums.length;
        int st=nums[0];
        int count=1;
        int j=1;
        int[] arr = new int[len];
        for(int i=1;i<len;i++)
        {
            if(st!=nums[i])
            {
                count++;
                st=nums[i];
                nums[j]=nums[i];
                j++;
            }
        }
        return count;
    }
}
