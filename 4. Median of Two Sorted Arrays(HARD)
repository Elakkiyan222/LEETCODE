class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) 
    {
        int n=nums1.length;
        int m=nums2.length;
        int[] arr=new int[m+n];
        for(int i=0;i<n;i++)
        {
            arr[i]=nums1[i];
        }
        for(int i=0;i<m;i++)
        {
            arr[n+i]=nums2[i];
        }
        Arrays.sort(arr);
        if(arr.length%2!=0)
        {
            int num=arr.length/2;
            return arr[num];
        }
        else
        {
            int num2=arr.length/2;
            int sum=0;
            sum=arr[num2-1]+arr[num2];
            double med=sum/2.0;
            return med;
        }
    }
}
