class Solution {
    public int maxProfit(int[] prices) {
        int small=prices[0];
        int profit=0;
        for(int i=1;i<prices.length;i++)
        {
            if(prices[i]<small)
            {
                small=prices[i];
            }
            int fin=prices[i]-small;
            if(fin>profit)
            {
                profit=fin;
            }
        }
        return profit;
    }
}
