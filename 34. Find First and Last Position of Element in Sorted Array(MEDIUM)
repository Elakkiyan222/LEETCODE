class Solution {
    public int[] searchRange(int[] nums, int target) 
    {
        int[] arr=new int[2];
        if(nums.length==0)
        {
            arr[0]=-1;
            arr[1]=-1;
            return arr;
        }
        for(int i=0;i<nums.length;i++)
        {
            if(nums[i]==target)
            {
                arr[0]=i;
                int count=i;
                for(int j=i+1;j<nums.length;j++)
                {
                    if(nums[j]==target)
                    {
                        count++;
                    }
                    else
                    {
                        break;
                    }
                }
                arr[1]=count;
                return arr;
            }
        }
        arr[0]=-1;
        arr[1]=-1;
        return arr;
    }
}
