class Solution {
    public int searchInsert(int[] nums, int target) {
        int len=nums.length;
        int flag=0;
        for(int i=0;i<len;i++)
        {
            if(nums[i]==target)
            {
                return i;
            }
        }
        int small=nums[0];
        for(int j=0;j<len-1;j++)
        {
            if(nums[j]<target && nums[j+1]>target)
            {
                return j+1;
            }
        }
        if(nums[len-1]<target)
        {
            return len;
        }
        else if(nums[0]>target)
        {
            return 0;
        }
        return -1;
    }
}
