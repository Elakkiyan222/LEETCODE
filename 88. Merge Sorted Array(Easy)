class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n){
        int q=m+n;
        int[] arr=new int[q];
        int j=0,k=0;
        for(int i=0;i<m;i++)
        {
            if(nums1[i]!=0)
            {
                arr[j]= nums1[i];
                j++;
            }
            k++;
            
        }
        for(int i=0;i<n;i++)
        {
            if(nums2[i]!=0)
            {
                arr[j]=nums2[i];
                j++;
            }
            k++;
        }
        Arrays.sort(arr);
        for (int i = 0; i < arr.length; i++)
        {
            nums1[i] = arr[i];
        }
    }
}
