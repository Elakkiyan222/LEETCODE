class Solution {
    private int[] org;
    private int[] num;
    private Random rand;
    public Solution(int[] nums) {
        this.num=nums;
        this.org=nums.clone();
        this.rand=new Random();
    }
    
    public int[] reset() {
        this.num=this.org.clone();
        return this.num;
    }
    
    public int[] shuffle() {
        for(int i=num.length-1;i>0;i--)
        {
            int k=rand.nextInt(i+1);
            int temp=num[i];
            num[i]=num[k];
            num[k]=temp;
        }
        return num;
    }
}

