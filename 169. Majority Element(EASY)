class Solution {
    public int majorityElement(int[] nums) {
        int l=nums.length;
        for(int i=0;i<l;i++)
        {
            int f=nums[i];
            int count=1;
            for(int j=0;j<l;j++)
            {
                if(f==nums[j] && i!=j)
                {
                    count+=1;
                }
            }
            if(l/2<count)
            {
                return nums[i];
            }
        }
        return 0;
    }
}
